        "jsCode": "// 1. Pega o texto bruto que veio do nó do Gemini anterior\nconst textoBruto = $input.item.json.content.parts[0].text;\n\n// 2. Limpa os blocos de markdown igualzinho ao seu código Python\nconst textoLimpo = textoBruto.replace(/```json|```/g, '').trim();\n\n// 3. Converte a string limpa em um objeto JSON real para o n8n usar\nconst dadosIA = JSON.parse(textoLimpo);\n\n// 4. Retorna os dados prontos para o nó de e-mail ler\nreturn {\n  json: {\n    nome: $('Google Sheets Trigger').item.json[\"Nome:\"], \n    email: $('Google Sheets Trigger').item.json[\"E-mail:\"],\n    departamento: $('Google Sheets Trigger').item.json[\"Departamento:\"],\n    feedback_texto: $('Google Sheets Trigger').item.json[\"Deixe aqui seu Feedback:\"],\n    resumo: dadosIA.resumo,\n    prioridade: dadosIA.prioridade,\n    sentimento: dadosIA.sentimento || dadosIA.sentimentos,\n    pontos_positivos: dadosIA.pontos_positivos,\n    pontos_criticos: dadosIA.pontos_criticos,\n    recomendacoes_gestao: dadosIA.recomendacoes_gestao,\n  }\n};\n"
      },
